# The Home Assistant Supervisor builds this on the Home Assistant box, with the repository root
# as the build context. It prefers Dockerfile.<arch> over the upstream ./Dockerfile, so keep
# Dockerfile.amd64 and Dockerfile.aarch64 identical.

# python:3.13-slim (3.13.16, Debian trixie), pinned for both architectures
ARG PYTHON_IMAGE=python:3.13-slim@sha256:70729b46c69b4f1e97c4822c1af3df53a1476cf5ddc6c087c0c10bc3a5678c2f

FROM ${PYTHON_IMAGE} AS build
WORKDIR /build
# The locked dependencies first, so code changes reuse this layer. pip refuses any file
# whose hash is not in uv.lock.
COPY pyproject.toml uv.lock ./
RUN pip install --no-cache-dir uv==0.11.32 \
    && uv export --frozen --no-dev --no-emit-project --extra music-assistant -o requirements.txt \
    && pip install --no-cache-dir --require-hashes --target /app -r requirements.txt
COPY README.md ./
COPY qobuz_proxy/ ./qobuz_proxy/
RUN pip install --no-cache-dir --no-deps --target /app .

FROM ${PYTHON_IMAGE}
ENV PYTHONUNBUFFERED=1 PYTHONPATH=/app QOBUZPROXY_DATA_DIR=/data
# The app runs as this user; start.py drops to it after preparing /data
RUN useradd --system --no-create-home --shell /usr/sbin/nologin qobuz-bridge \
    && pip uninstall --yes --quiet pip
COPY --from=build /app /app
COPY rootfs/ /
WORKDIR /data
CMD ["python3", "/start.py"]
