{
  "name": "Qobuz Bridge for Music Assistant",
  "version": "0.1.0",
  "slug": "qobuz_bridge",
  "description": "Pick your Music Assistant speakers and groups as Qobuz Connect devices in the Qobuz app",
  "url": "https://github.com/hazymorning/Qobuz-Bridge-for-Music-Assistant",
  "arch": ["aarch64", "amd64"],
  "startup": "application",
  "boot": "auto",
  "timeout": 20,
  "host_network": true,
  "ingress": true,
  "ingress_port": 8689,
  "panel_icon": "mdi:music-circle-outline",
  "panel_title": "Qobuz Bridge",
  "panel_admin": true,
  "hassio_api": true,
  "hassio_role": "default",
  "watchdog": "http://[HOST]:[PORT:8689]/api/status",
  "options": {
    "log_level": "info"
  },
  "schema": {
    "log_level": "list(debug|info|warning|error)"
  }
}
